metadata:
  language: v2-beta
  name: "SQLi - Phantom AI Login"
  description: "SQL injection tests for POST /login username and password fields."
  author: "BCheck-MCP"
  tags: "sqli", "injection", "bcheck-mcp"

given insertion point then
  send payload:
    replacing: "'"
  if {to_lower(latest.response.body)} matches "sql syntax|mysql_fetch|ora-[0-9]+|postgresql|sqlite_error|unclosed quotation mark|quoted string not properly terminated" then
    report issue:
      severity: high
      confidence: tentative
      detail: "Possible SQL injection: database error triggered by single-quote payload on login endpoint."
      remediation: "Use parameterised queries or prepared statements."
  end if
  send payload:
    replacing: "' AND SLEEP(5)-- -"
  if latest.response.duration > 4500 then
    report issue:
      severity: high
      confidence: tentative
      detail: "Possible time-based blind SQL injection via SLEEP(5) on login endpoint."
      remediation: "Use parameterised queries or prepared statements."
  end if
  send payload:
    replacing: "'; WAITFOR DELAY '0:0:5'-- -"
  if latest.response.duration > 4500 then
    report issue:
      severity: high
      confidence: tentative
      detail: "Possible time-based blind SQL injection (MSSQL) via WAITFOR DELAY on login endpoint."
      remediation: "Use parameterised queries or prepared statements."
  end if
