metadata:
  language: v2-beta
  name: "OAuth State SSRF - Phantom AI"
  description: "SSRF and open redirect via OAuth state parameter."
  author: "BCheck-MCP"
  tags: "ssrf", "open-redirect", "oauth", "bcheck-mcp"

given query insertion point then
  send payload:
    replacing: "http://169.254.169.254/"
  if {latest.response.body} matches "ami-id|instance-id|meta-data" then
    report issue:
      severity: critical
      confidence: firm
      detail: "SSRF via OAuth state: cloud metadata endpoint accessed."
      remediation: "Validate and whitelist URL destinations in OAuth state parameter."
  end if
