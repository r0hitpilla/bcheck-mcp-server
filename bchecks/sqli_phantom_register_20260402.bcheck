metadata:
  language: v2-beta
  name: "SQLi - Phantom AI Register"
  description: "SQL injection tests for registration endpoint fields."
  author: "BCheck-MCP"
  tags: "sqli", "injection", "bcheck-mcp"

given insertion point then
  send payload:
    replacing: "'"
  if {to_lower(latest.response.body)} matches "sql syntax|mysql_fetch|ora-[0-9]+|postgresql|sqlite_error|unclosed quotation mark|quoted string not properly terminated" then
    report issue:
      severity: high
      confidence: tentative
      detail: "Possible SQL injection in registration fields: database error triggered by single-quote payload."
      remediation: "Use parameterised queries or prepared statements."
  end if
  send payload:
    replacing: "' AND SLEEP(5)-- -"
  if latest.response.duration > 4500 then
    report issue:
      severity: high
      confidence: tentative
      detail: "Possible time-based blind SQL injection in registration fields via SLEEP(5)."
      remediation: "Use parameterised queries or prepared statements."
  end if
