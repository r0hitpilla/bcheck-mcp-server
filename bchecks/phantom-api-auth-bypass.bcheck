metadata:
  language: v2-beta
  name: "Auth Bypass - Phantom AI API"
  description: "Authorization header manipulation for Phantom AI API endpoints."
  author: "BCheck-MCP"
  tags: "auth-bypass", "bcheck-mcp"

given header insertion point then
  send payload:
    replacing: "null"
  if {latest.response.body} matches "job_id|task_id|scan_id|user_id" then
    report issue:
      severity: high
      confidence: tentative
      detail: "Possible auth bypass: null token returned API data."
      remediation: "Validate authorization tokens on every request. Reject null/empty tokens."
  end if
  send payload:
    replacing: "Bearer invalid"
  if {latest.response.body} matches "job_id|task_id|scan_id|user_id" then
    report issue:
      severity: high
      confidence: tentative
      detail: "Possible auth bypass: invalid bearer token returned API data."
      remediation: "Validate authorization tokens on every request."
  end if
