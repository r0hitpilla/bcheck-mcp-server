metadata:
  language: v2-beta
  name: "Session Tampering - Phantom AI"
  description: "Cookie manipulation tests for Phantom AI session handling."
  author: "BCheck-MCP"
  tags: "session", "cookie", "bcheck-mcp"

given cookie insertion point then
  send payload:
    replacing: "admin"
  if {to_lower(latest.response.body)} matches "admin|dashboard|manage|settings" then
    report issue:
      severity: high
      confidence: tentative
      detail: "Possible session tampering: replacing cookie value with 'admin' changed response."
      remediation: "Use signed, cryptographically strong session tokens. Validate server-side."
  end if
