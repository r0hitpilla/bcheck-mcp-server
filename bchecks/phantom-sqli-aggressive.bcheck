metadata:
  language: v2-beta
  name: "SQLi - Phantom AI Aggressive"
  description: "Aggressive stacked query and UNION-based SQL injection probes."
  author: "BCheck-MCP"
  tags: "sqli", "injection", "bcheck-mcp"

given insertion point then
  send payload:
    replacing: "1 UNION SELECT NULL,NULL,NULL-- -"
  if {to_lower(latest.response.body)} matches "null|column|union|syntax" then
    report issue:
      severity: high
      confidence: tentative
      detail: "Possible UNION-based SQL injection: UNION SELECT payload triggered changed response."
      remediation: "Use parameterised queries or prepared statements."
  end if
  send payload:
    replacing: "1; DROP TABLE users-- -"
  if {to_lower(latest.response.body)} matches "sql syntax|error|exception" then
    report issue:
      severity: high
      confidence: tentative
      detail: "Possible stacked query SQL injection: DROP TABLE payload triggered database error."
      remediation: "Use parameterised queries or prepared statements."
  end if
