metadata:
  language: v2-beta
  name: "XSS - Phantom Login Stored"
  description: "Stored XSS probe for Phantom AI login and registration."
  author: "BCheck-MCP"
  tags: "xss", "stored-xss", "bcheck-mcp"

given insertion point then
  send payload:
    replacing: "<img src=x onerror=alert(1)>"
  if {latest.response.body} matches "<img src=x onerror=alert" then
    report issue:
      severity: high
      confidence: tentative
      detail: "Possible stored/reflected XSS: img onerror payload reflected unescaped."
      remediation: "HTML-encode all user-supplied output. Apply a Content Security Policy."
  end if
